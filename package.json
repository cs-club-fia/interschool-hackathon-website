{
  "name": "hackathon-cf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interschool hackathon quiz platform on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init:local": "wrangler d1 migrations apply hackathon --local",
    "d1:init:remote": "wrangler d1 migrations apply hackathon --remote",
    "hash": "node scripts/gen-hash.mjs",
    "build-logins": "node scripts/build-logins.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "typescript": "^5.6.2",
    "wrangler": "^4.0.0"
  }
}
